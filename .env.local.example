# Copiá este archivo a .env.local y completá los valores reales.
# .env.local nunca se commitea (ver .gitignore).
#
# Credenciales OAuth2 para descargar los CV desde Google Drive
# (src/lib/googleDrive.ts). Se usa un refresh token de larga duración en vez
# de un service account porque la organización de Google Cloud bloquea la
# creación de keys de service account.

# Client ID y Client Secret del OAuth Client (Google Cloud Console > APIs y servicios > Credenciales).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Refresh token de larga duración, obtenido una vez mediante el flujo OAuth2
# con access_type=offline y prompt=consent, con scope de lectura de Drive
# (https://www.googleapis.com/auth/drive.readonly).
GOOGLE_OAUTH_REFRESH_TOKEN=

# File ID de Drive de cada CV (lo obtenés del link para compartir del archivo:
# https://drive.google.com/file/d/<FILE_ID>/view).
GOOGLE_DRIVE_CV_ES_FILE_ID=
GOOGLE_DRIVE_CV_EN_FILE_ID=

# Personal Access Token CLÁSICO de GitHub, scope "read:user" únicamente.
# Usado por src/app/api/github/contributions/route.ts (llamado en cada
# visita, nunca en build) para el insight de actividad (src/lib/github).
# read:user es lo mínimo que la API necesita para incluir contribuciones
# privadas y de organizaciones en contributionsCollection — un fine-grained
# PAT NO sirve acá: solo puede tener un resource owner (vos o una org, nunca
# ambos), así que nunca ve las dos fuentes en un mismo token.
GITHUB_TOKEN=
